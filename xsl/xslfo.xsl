<?xml version="1.0" encoding="UTF-8"?>
<!--
  PDF (XSL-FO) rendering for org.dita-community.codeinclude.

  Each token class has an attribute set named codeinclude.hl-<class>.
  A PDF customization plugin can redefine any of them to change colours.
-->
<xsl:stylesheet version="3.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:fo="http://www.w3.org/1999/XSL/Format"
                exclude-result-prefixes="#all">

  <xsl:attribute-set name="codeinclude.hl-comment">
    <xsl:attribute name="color">#6e7781</xsl:attribute>
    <xsl:attribute name="font-style">italic</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-keyword">
    <xsl:attribute name="color">#cf222e</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-key">
    <xsl:attribute name="color">#116329</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-string">
    <xsl:attribute name="color">#0a3069</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-number">
    <xsl:attribute name="color">#0550ae</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-literal">
    <xsl:attribute name="color">#0550ae</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-type">
    <xsl:attribute name="color">#953800</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-variable">
    <xsl:attribute name="color">#953800</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-meta">
    <xsl:attribute name="color">#8250df</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-tag">
    <xsl:attribute name="color">#116329</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-attr">
    <xsl:attribute name="color">#0550ae</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-section">
    <xsl:attribute name="color">#8250df</xsl:attribute>
    <xsl:attribute name="font-weight">bold</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-punct">
    <xsl:attribute name="color">#57606a</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-inserted">
    <xsl:attribute name="color">#116329</xsl:attribute>
    <xsl:attribute name="background-color">#e6ffec</xsl:attribute>
  </xsl:attribute-set>
  <xsl:attribute-set name="codeinclude.hl-deleted">
    <xsl:attribute name="color">#82071e</xsl:attribute>
    <xsl:attribute name="background-color">#ffebe9</xsl:attribute>
  </xsl:attribute-set>

  <!-- Highlight tokens generated by codeinclude.xsl -->
  <xsl:template match="*[contains(@class, ' topic/ph ')][starts-with(@outputclass, 'hl-')]
                        [ancestor::*[contains(@class, ' pr-d/codeblock ')]]" priority="10">
    <xsl:variable name="class" select="tokenize(@outputclass, '\s+')[starts-with(., 'hl-')][1]"/>
    <xsl:choose>
        <xsl:when test="$class = 'hl-comment'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-comment"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-keyword'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-keyword"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-key'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-key"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-string'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-string"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-number'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-number"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-literal'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-literal"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-type'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-type"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-variable'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-variable"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-meta'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-meta"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-tag'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-tag"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-attr'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-attr"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-section'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-section"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-punct'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-punct"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-inserted'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-inserted"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-deleted'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-deleted"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-cdata'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-string"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-option'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-attr"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:when test="$class = 'hl-entity'">
          <fo:inline xsl:use-attribute-sets="codeinclude.hl-attr"><xsl:apply-templates/></fo:inline>
        </xsl:when>
        <xsl:otherwise>
          <fo:inline><xsl:apply-templates/></fo:inline>
        </xsl:otherwise>
    </xsl:choose>
  </xsl:template>

</xsl:stylesheet>
